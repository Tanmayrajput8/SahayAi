# ============================================================
# SahayAI Emergency — Environment Configuration (.env.example)
# Research Prototype: AI Intelligence Layer for Ambulance Dispatch
# ============================================================

# Project Information
PROJECT_NAME="SahayAI Emergency"
PROJECT_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:8000"

# Database Configuration (SQLite for local research prototype)
DATABASE_URL="sqlite:///./sahayai_emergency.db"

# JWT Authentication
JWT_SECRET_KEY="CHANGE_ME_IN_PRODUCTION_USE_A_LONG_RANDOM_STRING"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Primary AI Intelligence Layer (Grok / xAI API)
# Set LLM_PROVIDER="grok" to use live Grok API; defaults to "mock" for offline testing
LLM_PROVIDER="mock"
GROK_API_KEY=""
GROK_BASE_URL="https://api.x.ai/v1"
GROK_MODEL="grok-4.6"
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=2
MOCK_MODE=True

# Geocoding (OpenStreetMap Nominatim REST API)
# Set GEOCODING_PROVIDER="nominatim" for live OpenStreetMap geocoding; defaults to "mock"
GEOCODING_PROVIDER="mock"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/search"
NOMINATIM_USER_AGENT="SahayAI-Emergency/1.0"
GEOCODING_TIMEOUT_SECONDS=5.0
GEOCODING_MAX_RETRIES=2

# Routing & ETA (OSRM REST API with Haversine Fallback)
ROUTING_PROVIDER="osrm"
OSRM_BASE_URL="https://router.project-osrm.org/route/v1/driving"
ROUTING_TIMEOUT_SECONDS=5.0
ROUTING_MAX_RETRIES=2

# Speech-to-Text (Optional external Whisper REST API)
# Defaults to "mock" if no key is configured
SPEECH_PROVIDER="mock"
STT_API_KEY=""
STT_API_URL="https://api.groq.com/openai/v1/audio/transcriptions"
STT_MODEL="whisper-large-v3"
